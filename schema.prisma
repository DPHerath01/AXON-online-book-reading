generator client {
  provider = "prisma-client-js"
}

// මෙන්න මේ කොටස විතරක් වෙනස් කරන්න
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}